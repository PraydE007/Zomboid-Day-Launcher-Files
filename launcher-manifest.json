{
  "project": {
    "name": "Zomboid Day",
    "version": "1.1.0",
    "launcher_version": "1.1.0",
    "description": "Основний пакет конфігурації, оптимізації пам'яті та ZombieBuddy для лаунчера Zomboid Day",
    "author": "PraydE007",
    "target_game": "Project Zomboid",
    "build_compatibility": "Build 41 / Build 42"
  },
  "install_steps": [
    {
      "id": "step_steam_workshop",
      "order": 1,
      "name": "Збірка модифікацій у Steam Workshop",
      "description": "Відкриття збірки модифікацій у клієнті Steam: https://steamcommunity.com/sharedfiles/filedetails/?id=3831192498",
      "type": "open_url",
      "url": "steam://url/CommunityFilePage/3831192498",
      "fallback_url": "https://steamcommunity.com/sharedfiles/filedetails/?id=3831192498"
    },
    {
      "id": "step_game_configs",
      "order": 2,
      "name": "Оптимізовані скрипти запуску JVM",
      "description": "Встановлення оптимізованих файлів ProjectZomboid64.bat та ProjectZomboid64ShowConsole.bat у папку лаунчера (zd-launcher)",
      "type": "copy_dir_contents",
      "source": "game-configuration-files",
      "destination": "{LAUNCHER_DIR}",
      "overwrite": true,
      "backup": false
    },
    {
      "id": "step_zombie_buddy",
      "order": 3,
      "name": "ZombieBuddy Java-Agent та zbNative DLL",
      "description": "Встановлення ZombieBuddy.jar та нативного завантажувача zbNative.dll у папку гри",
      "type": "copy_dir_contents",
      "source": "ZombieBuddy",
      "destination": "{GAME_DIR}",
      "overwrite": true,
      "backup": true
    }
  ],
  "validation": {
    "required_files": [
      {
        "path": "{LAUNCHER_DIR}/ProjectZomboid64.bat",
        "sha256": "c76a63be9f0126f7bd64e9f94abee32e0a9b3b9eaf275f83ac0a3b6d9cc61a6d",
        "name": "ProjectZomboid64.bat"
      },
      {
        "path": "{LAUNCHER_DIR}/ProjectZomboid64ShowConsole.bat",
        "sha256": "cbedbf5d25077f53d8b1b0339ac0c7d8c2c2bd6eb37ff710cdfa3b791b3c74c4",
        "name": "ProjectZomboid64ShowConsole.bat"
      },
      {
        "path": "{GAME_DIR}/ZombieBuddy.jar",
        "sha256": "eb79b9876332010733a8e0d7ce4fe0377846059a9e28859029e2a0fb449f6cf2",
        "name": "ZombieBuddy.jar"
      },
      {
        "path": "{GAME_DIR}/zbNative.dll",
        "sha256": "c2ae9335e717ee24b2f4a40d1a3bf77f1519762a72a0459e766a2bbafc077f6c",
        "name": "zbNative.dll"
      }
    ]
  },
  "launch": {
    "default_executable": "{LAUNCHER_DIR}/ProjectZomboid64.bat",
    "debug_executable": "{LAUNCHER_DIR}/ProjectZomboid64ShowConsole.bat",
    "working_dir": "{GAME_DIR}"
  }
}
